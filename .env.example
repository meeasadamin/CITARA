# Copy to .env and fill in. Never commit .env.
# On Streamlit Community Cloud, put these in the app's Secrets settings instead.
#
# Every value below is optional: src/citara/config.py holds validated defaults for the whole
# pipeline. Override any setting with CITARA_<SECTION>__<FIELD>, e.g. CITARA_RETRIEVAL__DENSE_K=16.

# --- Provider keys (unprefixed: Streamlit Cloud exposes secrets under these names) ---
GOOGLE_API_KEY=
GROQ_API_KEY=

# --- Application ---
CITARA_ENVIRONMENT=local
CITARA_LOG_LEVEL=INFO
CITARA_LOG_JSON=false

# --- Models ---
# Verified available 2026-09-17: gemini-3.5-flash-lite responds on the free tier.
# gemini-2.0-flash was shut down 2026-06-01; gemini-2.5-flash-lite is closed to new users.
# Groq llama-3.3-70b-versatile was retired 2026-08-16; openai/gpt-oss-120b replaces it.
CITARA_GENERATION__PRIMARY_MODEL=gemini-3.5-flash-lite
CITARA_GENERATION__FALLBACK_MODEL=openai/gpt-oss-120b
CITARA_EMBEDDING__MODEL_NAME=BAAI/bge-small-en-v1.5
CITARA_RETRIEVAL__RERANKER_MODEL=BAAI/bge-reranker-base

# --- Paths (relative to the project root) ---
CITARA_PATHS__DOCS_DIR=docs
CITARA_PATHS__DATA_DIR=data

# --- Retrieval funnel (ablation: dense | sparse | hybrid | hybrid_rerank) ---
CITARA_RETRIEVAL__MODE=hybrid_rerank
CITARA_RETRIEVAL__DENSE_K=12
CITARA_RETRIEVAL__SPARSE_K=12
CITARA_RETRIEVAL__TOP_K=5
# Calibrated on the gold set (scripts/calibrate_floor.py): admits no unanswerable question and
# refuses none whose evidence was actually retrieved. Re-run the calibration after changing
# chunking, retrieval or the reranker.
CITARA_RETRIEVAL__RELEVANCE_FLOOR=0.3386
