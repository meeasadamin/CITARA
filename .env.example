# Copy to .env and fill in. Never commit .env.
# On Streamlit Community Cloud, put the same keys in the app's Secrets settings instead.

# --- LLM provider keys (both free tier) ---
GOOGLE_API_KEY=
GROQ_API_KEY=

# --- Model IDs ---
# gemini-2.0-flash (the original spec choice) was shut down 2026-06-01.
# Confirm the current free-tier Flash model in Google AI Studio before relying on this default.
CITARA_PRIMARY_LLM_MODEL=gemini-3.5-flash-lite
# llama-3.3-70b-versatile (the original spec choice) was retired on Groq free/dev tier 2026-08-16.
CITARA_FALLBACK_LLM_MODEL=openai/gpt-oss-120b
CITARA_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
CITARA_RERANKER_MODEL=BAAI/bge-reranker-base

# --- Paths (relative to project root) ---
CITARA_DOCS_DIR=docs
CITARA_DATA_DIR=data

# --- Logging ---
CITARA_LOG_LEVEL=INFO
